# PostgreSQL pooled connection for the running application
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1

# Direct PostgreSQL connection for Prisma migrations
DIRECT_URL=postgresql://USER:PASSWORD@DB_HOST:5432/postgres

# Public production URL used for Xendit redirects
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Xendit Test Mode secret API key (never expose with NEXT_PUBLIC_)
XENDIT_SECRET_KEY=xnd_development_replace_me

# Xendit Dashboard invoice callback verification token
XENDIT_CALLBACK_TOKEN=replace_with_xendit_callback_token

# Admin access
ADMIN_PASSWORD=replace_with_a_long_unique_password
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_characters
